# All values below are placeholders; copy to .env.local and use your own services.
# Never commit .env.local or put private keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox credentials remain dedicated to the protected administrator.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Production personal, employer and agency billing uses live credentials.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# JSON map of careers_plus and six business plan codes to live priceId and productId.
STRIPE_LIVE_PLANS=
STRIPE_LIVE_PORTAL_EMPLOYER=
STRIPE_LIVE_PORTAL_AGENCY=
STRIPE_LIVE_PORTAL_RESTRICTED=
STRIPE_LIVE_PORTAL_INDIVIDUAL=
# Enable only for an explicitly configured live-billing development environment.
STRIPE_BUSINESS_LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
# Production-only AES-256-GCM key, 64 hexadecimal characters. Preserve v1 while copies exist.
FILE_RECOVERY_KEY_V1=
# Optional private operations token, authorises backup and a disposable restore check only.
FILE_RECOVERY_JOB_TOKEN=
# Keep staging and all demo inventory out of search engines.
ALLOW_INDEXING=false

# Google Ads employer measurement. Production delivery is opt-in and fails closed.
# Never enable these in development, preview or sandbox billing environments.
GOOGLE_ADS_CAPTURE_ENABLED=false
GOOGLE_ADS_DELIVERY_ENABLED=false
GOOGLE_ADS_PRODUCTION_ORIGINS=https://westmere.com.au
# Set an explicit ISO 8601 cutover timestamp with timezone at launch. No backfill uploads.
GOOGLE_ADS_TRACKING_START_AT=
GOOGLE_ADS_CONSENT_POLICY_REFERENCE=
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_REGISTRATION_LABEL=
# Purchase route B only: numeric UPLOAD_CLICKS action ID, not a website label/ID.
GOOGLE_ADS_PURCHASE_ROUTE=server_import
GOOGLE_ADS_CONVERSION_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_PURCHASE_IMPORT_ACTION_ID=
# Server-only OAuth credentials authorised for the Google Data Manager API.
GOOGLE_DATA_MANAGER_CLIENT_ID=
GOOGLE_DATA_MANAGER_CLIENT_SECRET=
GOOGLE_DATA_MANAGER_REFRESH_TOKEN=
# Enable only after manual data setup and the customer-data terms are ready.
GOOGLE_ADS_ENHANCED_CONVERSIONS_ENABLED=false
# Local UI review only; this never enables a production tag or upload.
GOOGLE_ADS_PRIVACY_UI_PREVIEW=false
